# jetson-pichick configuration. Copy to /etc/jchick/jchick.env on the Jetson.
# The systemd unit loads this file as EnvironmentFile.

# REQUIRED
NATS_URL=nats://192.168.0.76:4222
OLLAMA_URL=http://127.0.0.1:11434

# Models (must already be pulled via `ollama pull <name>` on this box).
# gate runs on every kept frame; detail runs only when gate fires.
# Using llava-phi3:3.8b for both — moondream:1.8b returns malformed JSON
# (Finding 10), and llava:7b (4.7GB) can't share VRAM with another model
# on the Orin Nano's 7.5GB unified memory. Single-model cascade avoids
# the model-swap stall that crashes Ollama with HTTP 500.
JCHICK_GATE_MODEL=llava-phi3:3.8b
JCHICK_DETAIL_MODEL=llava-phi3:3.8b

# Capture: synthetic | v4l2 | gstreamer
JCHICK_CAPTURE_SOURCE=v4l2
JCHICK_CAPTURE_DEVICE=/dev/video0
JCHICK_CAPTURE_FPS=1.0
JCHICK_CAPTURE_WIDTH=1280
JCHICK_CAPTURE_HEIGHT=720
JCHICK_SYNTHETIC_DIR=/var/lib/jchick/synthetic

# Frame-diff gate: skip frames whose mean abs pixel delta from the last
# frame is below this threshold (0..1). 0.008 ~= 0.8% saturation change.
# Lowered from 0.015 — real camera sensor noise keeps small movements
# under the old threshold, causing all frames to be skipped.
JCHICK_DIFF_THRESHOLD=0.008
JCHICK_DIFF_WARMUP=3

# Status cadence (seconds)
JCHICK_HEARTBEAT_SECONDS=300
JCHICK_TEGRASTATS_SECONDS=60

# Override the hostname used in NATS subject prefix.
# JCHICK_HOST=pichick

# Logging
JCHICK_LOG_LEVEL=INFO
